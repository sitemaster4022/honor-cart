import SiteLayout from '../layouts/SiteLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<SiteLayout title="For creators" description="HonorCart's plan for protecting creator and publisher referrals."><PageHero eyebrow="For creators & publishers" title="Proof should follow real protection events." lead="HonorCart is designing creator reporting around verifiable stand-down events. The dashboard and account system are not live yet."><div class="button-row"><a class="button" href="/signup">Join the creator beta</a></div></PageHero><section class="section soft"><div class="shell narrow centered"><p class="eyebrow">Current status</p><h2>No dashboard. No placeholder numbers.</h2><p class="lead-small max-copy">HonorCart does not currently publish creator traffic, checkout values, or commission estimates. When reporting launches, every figure must identify its source and limitations.</p></div></section><section class="section shell"><div class="three-grid"><article class="plain-card"><h3>Register identifiers</h3><p>The planned system will let creators add publisher IDs, sub IDs, campaign patterns, or other network-specific signals without sharing sensitive credentials.</p></article><article class="plain-card"><h3>Verify ownership</h3><p>Verification states will distinguish identifiers that are claimed, pending review, or verified.</p></article><article class="plain-card"><h3>Explain every metric</h3><p>Protection events will never be presented as network-confirmed conversions or earnings.</p></article></div></section></SiteLayout>
