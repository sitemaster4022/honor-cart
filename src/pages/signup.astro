---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Join the creator beta" lead="Tell us where to send early-access updates."><form class="auth-form" data-signup><label>Name<input name="name" placeholder="Your name" autocomplete="name" required/></label><label>Email address<input name="email" type="email" placeholder="you@example.com" autocomplete="email" required/></label><label>Creator or publication name<input name="publication" placeholder="Channel, site, or publication"/></label><button class="button" type="submit">Request early access</button><p class="form-note" data-message>This preview does not submit or store your information.</p></form><p class="auth-switch">Already registered? <a href="/login">Log in</a></p></AuthLayout><script>document.querySelector('[data-signup]')?.addEventListener('submit',e=>{e.preventDefault();const m=document.querySelector('[data-message]');if(m)m.textContent='Thanks — signup storage will be connected when authentication launches.';});</script>
