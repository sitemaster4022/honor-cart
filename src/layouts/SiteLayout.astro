---
import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import '../styles/global.css';
interface Props { title:string; description:string; noindex?:boolean; }
const {title,description,noindex=false}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex"/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin/><title>{title==='HonorCart'?title:`${title} · HonorCart`}</title></head><body><SiteHeader/><main><slot/></main><SiteFooter/></body></html>
