{
  "manifest_version": 3,
  "name": "HonorCart",
  "short_name": "HonorCart",
  "version": "1.0.0",
  "description": "Find coupons while protecting detected creator and affiliate referrals.",
  "minimum_chrome_version": "102",
  "homepage_url": "https://honorcart.com/",
  "permissions": ["activeTab", "storage", "webNavigation"],
  "host_permissions": ["https://honorcart.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "HonorCart",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "onboarding.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
